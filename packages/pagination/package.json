{
  "name": "@unleashit/pagination",
  "version": "2.0.5",
  "description": "Responsive pagination component for React.",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dist/*.css": "./dist/*.css",
    "./dist/*.module.css": "./src/scss/*.module.scss"
  },
  "publishConfig": {
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./dist/*.css": "./dist/*.css"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "*.png"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsup --tsconfig tsconfig.lib.json && pnpm sass:build",
    "dev": "concurrently 'NODE_ENV=development tsup --watch' 'pnpm sass'",
    "sass": "pnpm sass:build && pnpm sass:watch",
    "sass:build": "sass --load-path=../../shared/common/src/scss src/scss:dist && pnpm sass:postbuild",
    "sass:postbuild": "../../shared/scripts/postcssRename.js --name pagination ./dist/pagination.module.css",
    "sass:watch": "sass --watch --load-path=../../shared/common/src/scss src/scss:dist",
    "test": "NODE_ENV=test jest"
  },
  "license": "MIT",
  "keywords": [
    "pagination",
    "react",
    "responsive",
    "npm",
    "ui components",
    "ui library",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unleashit/npm-library.git"
  },
  "homepage": "https://github.com/unleashit/npm-library/tree/master/packages/pagination",
  "bugs": {
    "url": "https://github.com/unleashit/npm-library/issues"
  },
  "peerDependencies": {
    "react": "18.x || 19.x"
  },
  "dependencies": {
    "@unleashit/common": "workspace:*",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@unleashit/configs": "workspace:*"
  },
  "module": "dist/index.mjs"
}
