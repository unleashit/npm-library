{
  "name": "@unleashit/docs",
  "version": "2.0.4",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "outputs": ["{projectRoot}/build"],
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/packages/**/*.{ts,tsx}"
        ]
      }
    }
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "dev": "docusaurus start --port 3900",
    "build": "docusaurus clear && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "GIT_USER=unleashit USE_SSH=true docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@unleashit/common": "workspace:^",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "raw-loader": "^4.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "remark-code-snippets": "^1.1.0",
    "typescript": "6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
