{
  "extends": "../../tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "jsx": "react-jsx",
    // TS 6 no longer auto-includes node_modules/@types
    "types": ["node"],
    "outDir": "build",
    // this demo consumes the workspace packages as source via the root `paths` map,
    // so the common source root has to cover the whole repo
    "rootDir": "../..",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "declaration": false,
  }
}
